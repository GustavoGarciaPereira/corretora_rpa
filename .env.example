# Banco e evidências
DATABASE_URL=sqlite:///./data/corretor.db
EVIDENCE_DIR=./data/evidence

# Coleta
ENABLE_SCHEDULER=false
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0
TIMEZONE=America/Sao_Paulo
STALE_AFTER_HOURS=26
SEED_DEMO=true
LOG_LEVEL=INFO

# Plugins externos (separados por ":")
PLUGIN_PATHS=

# Bradesco (sessão gerada por login manual; nunca coloque senha aqui)
BRADESCO_STATE_PATH=./data/sessions/bradesco.json
BRADESCO_LOGIN_URL=https://wwwn.bradescoseguros.com.br/pnegocios2/wps/portal/portaldenegociosnovo/
SESSION_RENEWAL_ENABLED=true
SESSION_RENEWAL_TIMEOUT_S=600

# Login automático do portal (credenciais no keyring/Vault; nunca commitar)
BRADESCO_AUTO_LOGIN_ENABLED=true
BRADESCO_CREDENTIAL_SOURCE=keyring
BRADESCO_KEYRING_SERVICE=corretor-rpa
BRADESCO_KEYRING_USERNAME=bradesco-login
BRADESCO_LOGIN=
BRADESCO_LOGIN_USER=
BRADESCO_LOGIN_PASSWORD=
BRADESCO_AUTO_LOGIN_HEADLESS=true
BRADESCO_AUTO_LOGIN_TIMEOUT_S=120
BRADESCO_ENDPOINT=https://wwwn.bradescoseguros.com.br/pnegocios/wps/PA_BSPN-DBoardAuto-PU/api/parcelas/v1/list
BRADESCO_PROPOSALS_ENDPOINT=https://wwwn.bradescoseguros.com.br/pnegocios/wps/PA_BSPN-DBoardAuto-PU/api/propostas/pendentes/v1/view
BRADESCO_COLLECT_PARCELAS=false
BRADESCO_COLLECT_PROPOSALS=true
BRADESCO_HEADLESS=true
BRADESCO_TIMEOUT_MS=60000

# Bradesco API oficial (preencher credenciais via cofre/env; nunca commitar)
BRADESCO_MODE=auto
BRADESCO_API_BASE_URL=https://sauto.bradescoseguros.com.br/V2/WSBL-GerenciaCarteiraCsp/service
BRADESCO_API_TOKEN_URL=https://sauto.bradescoseguros.com.br/V2/Auth
BRADESCO_API_CLIENT_ID=
BRADESCO_API_CLIENT_SECRET=
BRADESCO_API_SECRET_SOURCE=env
BRADESCO_API_KEYRING_SERVICE=corretor-rpa
BRADESCO_API_KEYRING_USERNAME=bradesco-api
BRADESCO_API_CNPJ_PROVEDOR=
BRADESCO_API_CPF_CNPJ_CORRETOR=
BRADESCO_API_SCOPE=web
BRADESCO_API_FEATURE_TOGGLE=0
BRADESCO_API_TOKEN_EXTRA=
BRADESCO_API_CERT_PATH=
BRADESCO_API_KEY_PATH=
BRADESCO_API_CA_BUNDLE=
BRADESCO_API_VERIFY_TLS=true
BRADESCO_API_TIMEOUT_MS=60000
